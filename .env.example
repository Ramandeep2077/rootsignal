# Copy to .env and adjust. Everything here runs locally at $0 — no paid APIs.
# Never commit .env.

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=oncall
POSTGRES_PASSWORD=oncall-local-dev
POSTGRES_DB=oncall
POSTGRES_PORT=5432

# --- Kafka (Redpanda) ---
KAFKA_EXTERNAL_PORT=19092
ALERTS_TOPIC=alerts.raw
DECISIONS_TOPIC=incidents.decisions

# --- Alert service ---
ALERT_SERVICE_PORT=8080
ALERT_SERVICE_URL=http://localhost:8080
# Shared secret the agent service uses to write analysis back to the alert service.
INTERNAL_API_TOKEN=change-me-local-only

# --- LLM provider ---
# LLM_PROVIDER: "ollama" (local open-weight models) or "mock" (deterministic, used by tests/CI).
LLM_PROVIDER=ollama
# From inside containers Ollama on the host is reachable at host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434
# Model routing lives in agent-service/config/models.yaml; these override it per agent.
TRIAGE_MODEL=qwen2.5:1.5b
INVESTIGATOR_MODEL=qwen2.5:7b
REMEDIATION_MODEL=qwen2.5:7b
JUDGE_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=240
LLM_MAX_RETRIES=2

# --- Embeddings (local, CPU) ---
# EMBEDDINGS_PROVIDER: "local" (sentence-transformers model via ONNX/fastembed) or "hash" (tests/CI).
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Agent service ---
AGENT_SERVICE_PORT=8000
TRIAGE_WINDOW_SECONDS=20
SIMILARITY_THRESHOLD=0.55
# Guardrails: remediation is ALWAYS dry-run unless explicitly disabled AND approved by a human.
REMEDIATION_DRY_RUN=true

# --- MCP servers (streamable HTTP) ---
LOGS_MCP_URL=http://localhost:8101/mcp
METRICS_MCP_URL=http://localhost:8102/mcp
DEPLOYS_MCP_URL=http://localhost:8103/mcp
RUNBOOKS_MCP_URL=http://localhost:8104/mcp

# --- Notifications ---
# Leave SLACK_WEBHOOK_URL empty to use the bundled mock Slack receiver.
SLACK_WEBHOOK_URL=
SMTP_HOST=localhost
SMTP_PORT=1025
NOTIFY_EMAIL_TO=oncall@example.test
NOTIFY_EMAIL_FROM=copilot@example.test
DASHBOARD_URL=http://localhost:3000

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
